# ===== FUUDELIVERY Production Configuration =====
# Copy this to .env and fill in your values
#
# Referência canônica de URLs de produção: references/URLS.md

# App
PORT=3000
GO_ENV=production
JWT_SECRET=REPLACE_ME_WITH_openssl_rand_hex_32
API_BASE_URL=https://api.suaempresa.com
APP_URL=https://restaurante.suaempresa.com
# URL da API de pagamento usada no BUILD do WebAdmin. O payment_api roda
# dentro do monolito desde que o serviço isolado foi arquivado, então é o
# mesmo domínio de API_BASE_URL. Deixe vazio para o WebAdmin cair sozinho
# em API_BASE_URL.
PAYMENT_API_BASE_URL=
ALLOWED_ORIGINS=https://restaurante.suaempresa.com,https://admin.suaempresa.com

# Bootstrap único do primeiro admin (POST /admin/bootstrap). Remover após uso.
ADMIN_BOOTSTRAP_SECRET=

# PostgreSQL (Supabase) — pooler :6543 (PgBouncer transaction mode)
DB_CONNECTION_STRING=postgresql://postgres:password@aws-0-us-east-2.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require

# Supabase Storage/REST — upload de imagens (sem isso o endpoint responde 503)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service-role-key-aqui

# MongoDB legado: não é mais necessário em produção (banco único = Postgres).
# A migração histórica já foi concluída; não defina estas variáveis.

# Redis gerenciado (fila de pagamentos + cache + rate limit).
# Para fila financeira prefira política noeviction/volatile-lru.
REDIS_URL=redis://default:password@host:port

# AbacatePay - Brazilian payments (PIX + Card)
ABACATE_PAY_API_KEY=abc_your_api_key_here
ABACATE_PAY_WEBHOOK_SECRET=whsec_your_webhook_secret

# Proteção do GET /metrics (Bearer token). Vazio = endpoint público.
METRICS_TOKEN=

# ── Split na origem (marketplace Mercado Pago) ──────────────────────────────
# Cofre que cifra os tokens OAuth dos lojistas antes de irem ao banco.
# OBRIGATÓRIA para o fluxo de conectar conta MP. Gere com: openssl rand -hex 32
# (32 bytes = 64 caracteres hex). Nunca comite a chave real — só placeholder.
SECRET_ENCRYPTION_KEY=

# Aplicativo de marketplace da plataforma no painel do Mercado Pago.
# APP_ID = client_id do app; CLIENT_SECRET = o secret do mesmo app.
MERCADOPAGO_APP_ID=
MERCADOPAGO_CLIENT_SECRET=
# Precisa bater EXATAMENTE com a Redirect URI cadastrada no painel do MP.
MERCADOPAGO_OAUTH_REDIRECT=https://sua-api/payment/gateways/mercadopago/callback
# Segredo para assinar o parâmetro `state` do OAuth (anti-CSRF + identidade).
# Gere com openssl rand -hex 32. Vazio = endpoints de connect/callback dão 503.
MERCADOPAGO_OAUTH_STATE_SECRET=
# Para onde o browser volta depois do callback (tela do WebRestaurant).
# Vazio = o callback responde JSON em vez de redirecionar (útil em dev/teste).
MERCADOPAGO_OAUTH_RESULT_URL=
# Opcional: sobrescreve o host da tela de autorização do MP se o default mudar.
MERCADOPAGO_OAUTH_AUTH_URL=

# Servidor OSRM próprio para cálculo de rotas. Vazio = demo público (só dev).
OSRM_BASE_URL=

# Checagem interna de horário de funcionamento (default: próprio processo)
URL_CHECK_ESTABLISHMENT_OPEN=http://localhost:3000/api/auth/establishments/%d/is-open
