{
  "expo": {
    "name": "FuuRestaurante",
    "slug": "restaurante",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fuudelivery",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#DC2626"
      },
      "package": "com.fuudelivery.restaurante",
      "versionCode": 2
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@maplibre/maplibre-react-native"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "0ac16b6c-4a47-48ca-89f7-76ff97b2555d"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "pavanbr",
    "updates": {
      "url": "https://u.expo.dev/0ac16b6c-4a47-48ca-89f7-76ff97b2555d"
    }
  }
}
