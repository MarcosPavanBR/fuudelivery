# ===== FUUDELIVERY Production Configuration =====
# Copy this to .env and fill in your values
#
# Referência canônica de URLs de produção: references/URLS.md

# App
PORT=3000
GO_ENV=production
JWT_SECRET=REPLACE_ME_WITH_openssl_rand_hex_32
API_BASE_URL=https://api.suaempresa.com
APP_URL=https://restaurante.suaempresa.com
ALLOWED_ORIGINS=https://restaurante.suaempresa.com,https://admin.suaempresa.com

# Bootstrap único do primeiro admin (POST /admin/bootstrap). Remover após uso.
ADMIN_BOOTSTRAP_SECRET=

# PostgreSQL (Supabase) — pooler :6543 (PgBouncer transaction mode)
DB_CONNECTION_STRING=postgresql://postgres:password@aws-0-us-east-2.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require

# Supabase Storage/REST — upload de imagens (sem isso o endpoint responde 503)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service-role-key-aqui

# MongoDB Atlas (dual-write legado; opcional após aposentadoria do Atlas)
MONGO_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/fuudelivery?retryWrites=true&w=majority
MONGO_DATABASE=fuudelivery
PAYMENT_MONGO_DATABASE=fuudelivery_payments

# Redis gerenciado (fila de pagamentos + cache + rate limit).
# Para fila financeira prefira política noeviction/volatile-lru.
REDIS_URL=redis://default:password@host:port

# AbacatePay - Brazilian payments (PIX + Card)
ABACATE_PAY_API_KEY=abc_your_api_key_here
ABACATE_PAY_WEBHOOK_SECRET=whsec_your_webhook_secret

# Proteção do GET /metrics (Bearer token). Vazio = endpoint público.
METRICS_TOKEN=

# Servidor OSRM próprio para cálculo de rotas. Vazio = demo público (só dev).
OSRM_BASE_URL=

# Checagem interna de horário de funcionamento (default: próprio processo)
URL_CHECK_ESTABLISHMENT_OPEN=http://localhost:3000/api/auth/establishments/%d/is-open
