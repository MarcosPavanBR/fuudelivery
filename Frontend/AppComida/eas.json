{
  "cli": {
    "version": ">= 7.3.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "withoutCredentials": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://fuudelivery-api-8y6l.onrender.com"
      },
      "prebuildCommand": "npx expo prebuild --clean --platform android"
    },
    "production": {
      "android": {
        "buildType": "app-bundle",
        "withoutCredentials": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://fuudelivery-api-8y6l.onrender.com"
      },
      "prebuildCommand": "npx expo prebuild --clean --platform android"
    }
  },
  "submit": {
    "production": {}
  }
}
