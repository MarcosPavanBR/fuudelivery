# FuuDelivery - WebRestaurant (Painel do Restaurante)
# Copie este arquivo para .env.local para desenvolvimento local
# cp .env.example .env.local

# URL base da API Go (monolito)
# Em produção: https://fuudelivery-api-8y6l.onrender.com
# Em desenvolvimento: http://localhost:3000
REACT_APP_API_URL=https://fuudelivery-api-8y6l.onrender.com

# URL base do Payment Service (carteira do restaurante)
# Em produção: https://fuudelivery-payment.onrender.com
# Em desenvolvimento: http://localhost:8084
REACT_APP_PAYMENT_API_URL=https://fuudelivery-payment.onrender.com
